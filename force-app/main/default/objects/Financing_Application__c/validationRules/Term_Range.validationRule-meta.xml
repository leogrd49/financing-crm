<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Term_Range</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Term_Months__c &lt; 12, Term_Months__c &gt; 96)</errorConditionFormula>
    <errorDisplayField>Term_Months__c</errorDisplayField>
    <errorMessage>La durée doit être entre 12 et 96 mois.</errorMessage>
</ValidationRule>
